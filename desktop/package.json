{
  "name": "mangaforge",
  "productName": "MangaForge",
  "version": "0.3.4",
  "description": "Công cụ dịch truyện tranh mã nguồn mở: nhận diện chữ, xoá chữ, dịch theo ngữ cảnh, chèn chữ.",
  "license": "GPL-3.0-or-later",
  "author": "MangaForge contributors",
  "homepage": "https://github.com/PhamTienThang2510/MangaForge",
  "repository": "github:PhamTienThang2510/MangaForge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "fetch-uv": "node ../scripts/fetch_uv.js",
    "dist": "npm run fetch-uv && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run fetch-uv -- --linux && electron-builder --linux deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.mangaforge",
    "productName": "MangaForge",
    "artifactName": "MangaForge-Setup-${version}.${ext}",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../web",
        "to": "web"
      },
      {
        "from": "../fonts",
        "to": "fonts"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "bin/uv.exe",
          "to": "bin/uv.exe"
        }
      ]
    },
    "linux": {
      "target": ["deb"],
      "icon": "icon.png",
      "category": "Graphics",
      "artifactName": "MangaForge-${version}-amd64.deb",
      "extraResources": [
        {
          "from": "bin/linux/uv",
          "to": "bin/uv"
        }
      ]
    },
    "deb": {
      "maintainer": "MangaForge contributors <132671977+PhamTienThang2510@users.noreply.github.com>",
      "afterInstall": "../packaging/linux/after-install.tpl",
      "afterRemove": "../packaging/linux/after-remove.tpl"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MangaForge",
      "license": "../LICENSE",
      "deleteAppDataOnUninstall": false
    }
  }
}
